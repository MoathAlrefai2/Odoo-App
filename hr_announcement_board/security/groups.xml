<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HR Announcement Board Manager group -->
    <record id="group_hr_announcement_manager" model="res.groups">
        <field name="name">HR Announcement Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- HR Announcement Board User group (read-only employees) -->
    <record id="group_hr_announcement_user" model="res.groups">
        <field name="name">HR Announcement User</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Every internal user automatically gets the User group -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_announcement_board.group_hr_announcement_user'))]"/>
    </record>

    <!-- HR Managers automatically get the Manager group -->
    <record id="base.group_erp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_announcement_board.group_hr_announcement_manager'))]"/>
    </record>
</odoo>
