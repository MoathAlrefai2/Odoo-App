<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Record Rule: Employees can only read announcements that are:
        - state = 'published'
        - expiry_date is False OR expiry_date >= today
    -->
    <record id="rule_hr_announcement_employee_read" model="ir.rule">
        <field name="name">HR Announcement: Employee see published &amp; active only</field>
        <field name="model_id" ref="model_hr_announcement"/>
        <field name="groups" eval="[(4, ref('hr_announcement_board.group_hr_announcement_user'))]"/>
        <field name="domain_force">[
            ('state', '=', 'published'),
            '|',
            ('expiry_date', '=', False),
            ('expiry_date', '>=', time.strftime('%Y-%m-%d'))
        ]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Record Rule: Managers can see ALL announcements (no domain restriction).
    -->
    <record id="rule_hr_announcement_manager_all" model="ir.rule">
        <field name="name">HR Announcement: Manager sees all</field>
        <field name="model_id" ref="model_hr_announcement"/>
        <field name="groups" eval="[(4, ref('hr_announcement_board.group_hr_announcement_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
