<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ═══ LIST VIEW ═══════════════════════════════════════════════════ -->
        <record model="ir.ui.view" id="hr_announcement_list_view">
            <field name="name">hr.announcement.list</field>
            <field name="model">hr.announcement</field>
            <field name="arch" type="xml">
                <list decoration-danger="state == 'expired'"
                      decoration-success="state == 'published'"
                      decoration-muted="state == 'draft'">
                    <field name="is_pinned" widget="boolean_toggle" optional="show"/>
                    <field name="title"/>
                    <field name="author_id"/>
                    <field name="priority" widget="priority"/>
                    <field name="publish_date"/>
                    <field name="expiry_date"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'published'"
                           decoration-warning="state == 'draft'"
                           decoration-danger="state == 'expired'"/>
                </list>
            </field>
        </record>

        <!-- ═══ FORM VIEW ═══════════════════════════════════════════════════ -->
        <record model="ir.ui.view" id="hr_announcement_form_view">
            <field name="name">hr.announcement.form</field>
            <field name="model">hr.announcement</field>
            <field name="arch" type="xml">
                <form>
                    <!-- Status bar -->
                    <header>
                        <button name="action_publish" string="Publish"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"
                                groups="hr_announcement_board.group_hr_announcement_manager"/>
                        <button name="action_set_draft" string="Reset to Draft"
                                type="object"
                                invisible="state != 'published'"
                                groups="hr_announcement_board.group_hr_announcement_manager"/>
                        <button name="action_expire" string="Expire"
                                type="object"
                                invisible="state != 'published'"
                                groups="hr_announcement_board.group_hr_announcement_manager"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,published,expired"/>
                    </header>

                    <sheet>
                        <!-- Title + pin banner -->
                        <div class="oe_title">
                            <label for="title"/>
                            <h1>
                                <field name="title" placeholder="Announcement title…"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="author_id"/>
                                <field name="priority" widget="priority"/>
                                <field name="publish_date"/>
                                <field name="expiry_date"/>
                            </group>
                            <group>
                                <field name="is_pinned"/>
                            </group>
                        </group>

                        <separator string="Content"/>
                        <field name="body" widget="html"/>
                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ═══ ACTION ══════════════════════════════════════════════════════ -->
        <record model="ir.actions.act_window" id="action_hr_announcement_manager">
            <field name="name">Announcements</field>
            <field name="res_model">hr.announcement</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
        </record>
    </data>
</odoo>
