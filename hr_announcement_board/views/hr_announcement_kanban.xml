<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ═══ KANBAN VIEW (employee dashboard) ════════════════════════════ -->
        <record model="ir.ui.view" id="hr_announcement_kanban_view">
            <field name="name">hr.announcement.kanban</field>
            <field name="model">hr.announcement</field>
            <field name="arch" type="xml">
                <kanban create="0" edit="0" delete="0"
                        default_order="is_pinned desc, publish_date desc"
                        class="o_kanban_dashboard hr_announcement_kanban">
                    <field name="title"/>
                    <field name="body"/>
                    <field name="author_id"/>
                    <field name="priority"/>
                    <field name="publish_date"/>
                    <field name="expiry_date"/>
                    <field name="state"/>
                    <field name="is_pinned"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div type="open" t-attf-class="oe_kanban_card oe_kanban_global_click hr_announcement_card
                                               #{record.is_pinned.raw_value ? 'ha_pinned' : ''}
                                               ha_priority_#{record.priority.raw_value}">

                                <!-- Pin badge -->
                                <t t-if="record.is_pinned.raw_value">
                                    <span class="ha_pin_badge">
                                        <i class="fa fa-thumb-tack"/> Pinned
                                    </span>
                                </t>

                                <!-- Header -->
                                <div class="ha_card_header">
                                    <span class="ha_priority_dot"/>
                                    <strong class="ha_card_title">
                                        <field name="title"/>
                                    </strong>
                                </div>

                                <!-- Body preview (HTML rendered) -->
                                <div class="ha_card_body">
                                    <field name="body" widget="html"/>
                                </div>

                                <!-- Footer meta -->
                                <div class="ha_card_footer">
                                    <span class="ha_author">
                                        <i class="fa fa-user"/> <field name="author_id"/>
                                    </span>
                                    <span class="ha_dates">
                                        <i class="fa fa-calendar"/> <field name="publish_date"/>
                                        <t t-if="record.expiry_date.raw_value">
                                            → <field name="expiry_date"/>
                                        </t>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ═══ ACTION (employee dashboard – published &amp; active only) ═══ -->
        <record model="ir.actions.act_window" id="action_hr_announcement_board">
            <field name="name">My Announcements</field>
            <field name="res_model">hr.announcement</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('state', '=', 'published'), '|', ('expiry_date', '=', False), ('expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]</field>
            <field name="context">{'search_default_published': 1}</field>
        </record>
    </data>
</odoo>
