<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_hr_announcement_auto_expire" model="ir.cron">
            <field name="name">HR Announcement Board: Auto-Expire Announcements</field>
            <field name="model_id" ref="hr_announcement_board.model_hr_announcement"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_expire()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">1000</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
